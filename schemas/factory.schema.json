{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "factory", "planner", "plan_review", "intelligence", "implementers", "review", "evidence", "limits", "merge", "delivery"],
  "properties": {
    "version": {"const": 1},
    "factory": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "model": {"type": "string"},
    "planner": {"$ref": "#/$defs/agent"},
    "plan_review": {
      "allOf": [
        {"$ref": "#/$defs/agent"},
        {"type": "object", "required": ["min_score", "max_cycles"],
         "properties": {
           "min_score": {"type": "number", "minimum": 7, "maximum": 10, "multipleOf": 0.5},
           "max_cycles": {"type": "integer", "minimum": 1, "maximum": 5}
         }}
      ]
    },
    "intelligence": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "required", "auto_install"],
      "properties": {
        "provider": {"const": "graphify"},
        "required": {"type": "boolean"},
        "auto_install": {"type": "boolean"}
      }
    },
    "implementers": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/agent"},
          {"type": "object", "required": ["id", "scope"],
           "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
                          "scope": {"type": "string", "minLength": 1}}}
        ]
      }
    },
    "review": {
      "allOf": [
        {"$ref": "#/$defs/agent"},
        {"type": "object", "required": ["max_cycles"],
         "properties": {"max_cycles": {"type": "integer", "minimum": 1, "maximum": 5}}}
      ]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["screenshots", "video"],
      "properties": {
        "policy": {"enum": ["always", "plan", "never"]},
        "capture_commands": {"type": "array", "items": {"type": "string"}},
        "screenshots": {"type": "array", "items": {"type": "string"}},
        "video": {"type": ["string", "null"]},
        "artifacts": {"type": "array", "items": {"type": "string"}},
        "test_commands": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["agent_timeout_seconds", "command_timeout_seconds", "termination_grace_seconds", "max_total_tokens", "max_total_cost_usd", "require_usage"],
      "properties": {
        "agent_timeout_seconds": {"type": ["integer", "null"], "minimum": 1},
        "command_timeout_seconds": {"type": ["integer", "null"], "minimum": 1},
        "termination_grace_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_total_tokens": {"type": ["integer", "null"], "minimum": 1},
        "max_total_cost_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "require_usage": {"type": "boolean"}
      }
    },
    "merge": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "apply"],
      "properties": {"target": {"type": "string"}, "apply": {"type": "boolean"}}
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "deploy_commands", "health_commands", "rollback_commands"],
      "properties": {
        "enabled": {"type": "boolean"},
        "deploy_commands": {"type": "array", "items": {"type": "string"}},
        "health_commands": {"type": "array", "items": {"type": "string"}},
        "rollback_commands": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object", "additionalProperties": true,
      "required": ["harness", "model", "instructions"],
      "properties": {
        "harness": {"enum": ["pi", "claude-code", "codex"]},
        "model": {"type": "string", "minLength": 1},
        "thinking": {"enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]},
        "instructions": {"type": "string", "minLength": 1},
        "skills": {"type": "array", "items": {"type": "string"}},
        "tools": {"type": "array", "items": {"type": "string"}},
        "timeout_seconds": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
